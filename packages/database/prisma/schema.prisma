/// Blog taxonomy (independent from the concept categories): "Planlama", "Trendler", "DIY" …
model BlogCategory {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(140)
  slug        String        @unique @db.VarChar(160)
  description String?       @db.Text
  status      ContentStatus @default(PUBLISHED)
  sortOrder   Int           @default(0) @map("sort_order")
  posts       BlogPost[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("blog_categories")
}

/// Editorial blog article (Markdown body). Public only when PUBLISHED and `publishedAt <= now()`,
/// so a future `publishedAt` schedules the post.
model BlogPost {
  id             String             @id @default(uuid()) @db.Uuid
  categoryId     String?            @map("category_id") @db.Uuid
  /// Public byline (an editor). `createdById` / `updatedById` are audit attribution only.
  authorId       String?            @map("author_id") @db.Uuid
  createdById    String?            @map("created_by_id") @db.Uuid
  updatedById    String?            @map("updated_by_id") @db.Uuid
  title          String             @db.VarChar(180)
  slug           String             @unique @db.VarChar(200)
  excerpt        String             @db.VarChar(320)
  body           String             @db.Text
  coverImageUrl  String?            @map("cover_image_url") @db.VarChar(2048)
  coverImageAlt  String?            @map("cover_image_alt") @db.VarChar(220)
  tags           String[]           @default([])
  status         ContentStatus      @default(DRAFT)
  indexability   IndexabilityStatus @default(INDEX)
  featured       Boolean            @default(false)
  seoTitle       String?            @map("seo_title") @db.VarChar(70)
  seoDescription String?            @map("seo_description") @db.VarChar(170)
  readingMinutes Int                @default(1) @map("reading_minutes")
  viewCount      Int                @default(0) @map("view_count")
  category       BlogCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         User?              @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("BlogPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?              @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  publishedAt    DateTime?          @map("published_at")

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@map("blog_posts")
}

