/// One-time tokens for e-mail verification and password reset (hash stored, raw value mailed).
enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("auth_tokens")
}

/// External identity providers linked to a User. Only identity (provider + subject) is stored:
/// no access/refresh tokens, because Konsepthane never calls provider APIs on the user's behalf.
enum OAuthProvider {
  GOOGLE
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  /// Stable subject id from the provider (Google `sub`), never the e-mail.
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  /// E-mail as reported by the provider at link time (informational; the User e-mail is canonical).
  email             String?       @db.VarChar(320)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}
