# ==========================================================================
# Konsepthane — production environment template
# Copy to `.env` on the server and fill every placeholder. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48
# ==========================================================================
NODE_ENV=production

# --- Public URLs (drive canonical URLs, sitemap, OG, JSON-LD, e-mail links, cookies) ---
WEB_URL=https://konsepthane.net
ADMIN_URL=https://konsepthane.net/admin
API_URL=https://konsepthane.net/api
NEXT_PUBLIC_API_URL=https://konsepthane.net/api
INTERNAL_API_URL=http://api:4000

# --- Host ports: only the router binds one (127.0.0.1:NGINX_PORT, proxied by Plesk nginx); the app
# ports below are informational (containers are reached on the compose network, no host binding) ---
NGINX_PORT=8180
WEB_PORT=3210
ADMIN_PORT=3211
API_PORT=4010
WORKER_PORT=4011

# --- PostgreSQL (managed instance strongly recommended; the compose one is a fallback) ---
POSTGRES_DB=konsepthane
POSTGRES_USER=konsepthane
POSTGRES_PASSWORD=75c2c61f8e6ff2f4998745149fece17739b201e286bdf1173121e998e874c7f1
DATABASE_URL=postgresql://konsepthane:75c2c61f8e6ff2f4998745149fece17739b201e286bdf1173121e998e874c7f1@postgres:5432/konsepthane?schema=public

# --- Redis / Meilisearch (internal only) ---
REDIS_URL=redis://redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=3e4f0da639b9c0b00016b0f626121ca54d81b1a6a40f9ca2760dddc309bd82ad

# --- Object storage: Cloudflare R2 (S3 API). Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com ---
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=konsepthane-media
S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true
# Browser-facing URL of the bucket or CDN in front of it (no trailing slash)
MEDIA_PUBLIC_URL=https://media.konsepthane.net
NEXT_PUBLIC_MEDIA_URL=https://media.konsepthane.net
# Leave empty when the bucket is publicly reachable from the web container; set to the bucket URL
# reachable from inside the network if the web app must proxy /media/* itself.
INTERNAL_MEDIA_URL=

# --- Transactional e-mail via Brevo SMTP (verification, password reset, system mails) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_BREVO_SMTP_LOGIN
SMTP_PASS=CHANGE_ME_BREVO_SMTP_KEY
SMTP_SECURE=false
MAIL_FROM="Konsepthane <noreply@konsepthane.net>"

# --- Auth ---
JWT_ACCESS_SECRET=794444e7bcdd66b9fa430bac0614f40b921bc0c0efd36bdf627e40b2335d65d54a601b8a718fad36f4c745857b4e22cb
JWT_REFRESH_SECRET=fa922ce689d5eec619d1da7cf2fc322f7bf159e71434871c45c298cf8b4fe63a015efffd7455800e865f83ff0ac0a8a4
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Site identity shown on trust/legal pages and in Organization JSON-LD ---
NEXT_PUBLIC_LEGAL_NAME=konsepthane.net
NEXT_PUBLIC_CONTACT_EMAIL=info@konsepthane.net
NEXT_PUBLIC_PRIVACY_EMAIL=info@konsepthane.net
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Analytics (loaded only after cookie consent). Leave empty to disable. ---
NEXT_PUBLIC_GA_ID=G-0Q7XW1FPLN

# --- Launch data: never load sample data in production ---
SEED_SAMPLE_DATA=0

# --- Backups (compose.prod.yaml postgres-backup service) ---
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
BACKUP_SCHEDULE=@daily

# TLS: terminated by Plesk (Let's Encrypt extension) in front of NGINX_PORT — nothing to set here.

# --- Google sign-in ("Google ile devam et") ---
# Web app (server only): OAuth client of type "Web application". Callback = WEB_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API: comma-separated list of every first-party client id allowed as token audience (web now; Android/iOS later)
GOOGLE_CLIENT_IDS=

# Google-certified CMP (Cookiebot / Usercentrics). Domain Group ID from the Cookiebot dashboard; public by design.
# Empty = no consent dialog AND no analytics (safe default). Required before AdSense.
NEXT_PUBLIC_COOKIEBOT_ID=
# Absolute base URL for images inside e-mails (defaults to WEB_URL)
MAIL_ASSET_BASE=

# --- Launch admin (used by `pnpm db:reset:launch`; e-mail or username both sign in) ---
ADMIN_USERNAME=konsepthane
ADMIN_EMAIL=admin@konsepthane.net
ADMIN_PASSWORD=change-me-min-10-chars

# --- Security headers (web) ---
# 1 = send Content-Security-Policy-Report-Only instead of enforcing (observe violations in `docker compose logs web | grep csp`).
CSP_REPORT_ONLY=0

# --- Mobile app (konsepthane-mobile) deep links -------------------------------------------
# Apple Developer Team ID (App Store Connect -> Membership). Enables /.well-known/apple-app-site-association
APPLE_TEAM_ID=
# SHA-256 fingerprints of the Android signing certs (EAS keystore + Play App Signing), comma-separated.
ANDROID_CERT_SHA256=

# --- ContentOS publishing bridge (Publishing API v1 contract) ---
# Dedicated machine secret for the ContentOS service (min 32 chars; never a user/admin token).
# Unset = the /internal/contentos endpoints answer 503 (integration disabled).
CONTENTOS_SERVICE_TOKEN=
# ACTIVE user e-mail that owns ContentOS publications (the public byline falls back to the
# organisation unless this user has an editor profile). Unset = publications answer 503.
CONTENTOS_AUTHOR_EMAIL=
