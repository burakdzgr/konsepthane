# ==========================================================================
# Konsepthane — production environment template
# Copy to `.env` on the server and fill every "CHANGE_ME". Never commit the real file.
# Generate secrets with:  openssl rand -base64 48
# ==========================================================================
NODE_ENV=production

# --- Public URLs (drive canonical URLs, sitemap, OG, JSON-LD, e-mail links, cookies) ---
WEB_URL=https://konsepthane.net
ADMIN_URL=https://konsepthane.net/admin
API_URL=https://konsepthane.net/api
NEXT_PUBLIC_API_URL=https://konsepthane.net/api
INTERNAL_API_URL=http://api:4000

# --- Ports (bound only to localhost behind nginx) ---
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
WORKER_PORT=4001

# --- PostgreSQL (managed instance strongly recommended; the compose one is a fallback) ---
POSTGRES_DB=konsepthane
POSTGRES_USER=konsepthane
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://konsepthane:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/konsepthane?schema=public

# --- Redis / Meilisearch (internal only) ---
REDIS_URL=redis://redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME_32_RANDOM_CHARS

# --- Object storage: S3-compatible (AWS S3, Cloudflare R2, DigitalOcean Spaces, or MinIO on the host) ---
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=konsepthane-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
# Browser-facing URL of the bucket or CDN in front of it (no trailing slash)
MEDIA_PUBLIC_URL=https://media.konsepthane.net
NEXT_PUBLIC_MEDIA_URL=https://media.konsepthane.net
# Leave empty when the bucket is publicly reachable from the web container; set to the bucket URL
# reachable from inside the network if the web app must proxy /media/* itself.
INTERNAL_MEDIA_URL=

# --- Transactional e-mail (verification, password reset). Any SMTP provider. ---
SMTP_HOST=smtp.CHANGE_ME.com
SMTP_PORT=587
SMTP_USER=noreply@konsepthane.net
SMTP_PASS=CHANGE_ME
SMTP_SECURE=false
MAIL_FROM="Konsepthane <noreply@konsepthane.net>"

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Site identity shown on trust/legal pages and in Organization JSON-LD ---
NEXT_PUBLIC_LEGAL_NAME=konsepthane.net
NEXT_PUBLIC_CONTACT_EMAIL=info@konsepthane.net
NEXT_PUBLIC_PRIVACY_EMAIL=info@konsepthane.net
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Analytics (loaded only after cookie consent). Leave empty to disable. ---
NEXT_PUBLIC_GA_ID=G-0Q7XW1FPLN

# --- Launch data: never load sample data in production ---
SEED_SAMPLE_DATA=0

# --- Backups (compose.prod.yaml postgres-backup service) ---
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
BACKUP_SCHEDULE=@daily

# --- TLS (compose.prod.yaml certbot) ---
LETSENCRYPT_EMAIL=CHANGE_ME@konsepthane.net
DOMAIN=konsepthane.net

# --- Google sign-in ("Google ile devam et") ---
# Web app (server only): OAuth client of type "Web application". Callback = WEB_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API: comma-separated list of every first-party client id allowed as token audience (web now; Android/iOS later)
GOOGLE_CLIENT_IDS=

# Google-certified CMP (Cookiebot / Usercentrics). Domain Group ID from the Cookiebot dashboard; public by design.
# Empty = no consent dialog AND no analytics (safe default). Required before AdSense.
NEXT_PUBLIC_COOKIEBOT_ID=
# Absolute base URL for images inside e-mails (defaults to WEB_URL)
MAIL_ASSET_BASE=

# --- Launch admin (used by `pnpm db:reset:launch`; e-mail or username both sign in) ---
ADMIN_USERNAME=konsepthane
ADMIN_EMAIL=admin@konsepthane.net
ADMIN_PASSWORD=change-me-min-10-chars
