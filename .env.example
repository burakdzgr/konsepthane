NODE_ENV=development
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
WORKER_PORT=4001
NGINX_PORT=8080
POSTGRES_DB=ilham
POSTGRES_USER=ilham
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://ilham:change-me-local-only@localhost:5432/ilham?schema=public
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-minimum-16-characters
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ilham-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
# Browser-reachable base URL of the bucket (CDN in production); admin uploads store `MEDIA_PUBLIC_URL/<key>`.
MEDIA_PUBLIC_URL=http://localhost:9000/ilham-media
SMTP_HOST=localhost
SMTP_PORT=1025
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000
ADMIN_USERNAME=konsepthane
ADMIN_EMAIL=admin@konsepthane.net
ADMIN_PASSWORD=change-me-min-10-chars
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
# 1 = load the local sample data on `docker compose up` (development only). Leave 0 for launch data.
SEED_SAMPLE_DATA=0
MAIL_FROM="Konsepthane <noreply@konsepthane.net>"
NEXT_PUBLIC_CONTACT_EMAIL=info@konsepthane.net
NEXT_PUBLIC_PRIVACY_EMAIL=info@konsepthane.net
NEXT_PUBLIC_LEGAL_NAME=konsepthane.net
# GA4 measurement id; loads only after cookie consent
NEXT_PUBLIC_GA_ID=

# --- Google sign-in ("Google ile devam et") ---
# Web app (server only): OAuth client of type "Web application". Callback = WEB_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API: comma-separated list of every first-party client id allowed as token audience (web now; Android/iOS later)
GOOGLE_CLIENT_IDS=

# Google-certified CMP (Cookiebot / Usercentrics). Domain Group ID from the Cookiebot dashboard; public by design.
# Empty = no consent dialog AND no analytics (safe default). Required before AdSense.
NEXT_PUBLIC_COOKIEBOT_ID=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
# Absolute base URL for images inside e-mails (defaults to WEB_URL)
MAIL_ASSET_BASE=
