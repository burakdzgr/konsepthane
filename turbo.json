{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "@ilham/database#generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@ilham/database#generate"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "cache": false
    }
  },
  "globalEnv": [
    "ADMIN_URL",
    "API_URL",
    "INTERNAL_API_URL",
    "INTERNAL_MEDIA_URL",
    "MEDIA_PUBLIC_URL",
    "NEXT_PUBLIC_*",
    "NODE_ENV",
    "WEB_URL"
  ]
}
